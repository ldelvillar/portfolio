---
import { Image } from 'astro:assets';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { ImageMetadata } from 'astro';
import Github from '@/assets/icons/logos/Github.astro';
import Link from '@/assets/icons/Link.astro';

interface Props {
  image: ImageMetadata;
  title: string;
  technologies: {
    icon: AstroComponentFactory;
    name: string;
    bgcolor: string;
  }[];
  description: string;
  github: string;
  preview?: string;
  reverse?: boolean;
}

const {
  image,
  title,
  technologies,
  description,
  github,
  preview,
  reverse = false,
} = Astro.props;

const visibleTech = technologies.slice(0, 4);
const extraTech = technologies.length - visibleTech.length;
---

<article
  class="group flex flex-col gap-5 md:grid md:grid-cols-12 md:items-center md:gap-0"
>
  <div
    class:list={[
      'overflow-hidden rounded-2xl shadow-xl md:col-span-8 md:row-start-1 md:shadow-none',
      reverse ? 'md:col-start-5' : 'md:col-start-1',
    ]}
  >
    <Image
      src={image}
      alt="project card"
      width={600}
      height={400}
      densities={[1, 2]}
      class="h-56 w-full object-cover object-top transition duration-700 md:h-64 md:group-hover:scale-[1.04]"
      loading="lazy"
    />
  </div>
  <div
    class:list={[
      'relative z-10 md:col-span-6 md:row-start-1',
      reverse ? 'md:col-start-1' : 'md:col-start-7',
    ]}
  >
    <div
      class="rounded-2xl bg-gray-50/92 p-6 shadow-[0_18px_50px_-24px_rgba(17,24,39,.35)] backdrop-blur-md dark:bg-gray-900/90 dark:shadow-[0_18px_50px_-24px_rgba(0,0,0,.8)]"
    >
      <h3
        class="text-2xl leading-tight font-bold text-gray-900 dark:text-gray-50"
      >
        {title}
      </h3>
      <p
        class="mt-2 text-[15px] leading-relaxed text-gray-600 md:min-h-24.5 dark:text-gray-400"
      >
        {description}
      </p>
      <ul class="mt-4 flex flex-wrap items-center gap-2">
        {
          visibleTech.map(technology => (
            <li>
              <span
                class={`inline-flex items-center gap-2 rounded-full ${technology.bgcolor} px-2.5 py-0.5 text-[13px] leading-5 whitespace-nowrap text-gray-200`}
              >
                <technology.icon class="size-4" />
                {technology.name}
              </span>
            </li>
          ))
        }
        {
          extraTech > 0 && (
            <li class="font-mono text-xs text-gray-500 dark:text-gray-400">
              +{extraTech}
            </li>
          )
        }
      </ul>
      <footer class="mt-5 flex gap-5 text-sm font-bold">
        {
          preview && (
            <a
              href={preview}
              target="_blank"
              class="inline-flex items-center gap-1.5 border-b-2 border-yellow-400 pb-0.5 text-gray-900 transition hover:border-gray-900 focus-visible:ring focus-visible:ring-yellow-500/80 focus-visible:outline-none dark:text-gray-50 dark:hover:border-gray-50"
            >
              <Link class="size-4" />
              Preview
            </a>
          )
        }
        <a
          href={github}
          target="_blank"
          class="inline-flex items-center gap-1.5 border-b-2 border-transparent pb-0.5 text-gray-600 transition hover:border-gray-300 hover:text-gray-900 focus-visible:ring focus-visible:ring-yellow-500/80 focus-visible:outline-none dark:text-gray-400 dark:hover:border-gray-600 dark:hover:text-gray-50"
        >
          <Github class="size-4" />
          Code
        </a>
      </footer>
    </div>
  </div>
</article>
