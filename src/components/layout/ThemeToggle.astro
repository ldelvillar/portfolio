---
import SunIcon from '@/assets/icons/Sun.astro';
import MoonIcon from '@/assets/icons/Moon.astro';
import SystemIcon from '@/assets/icons/System.astro';
import type { Translations } from '@/utils/getTranslations';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const THEMES = [
  { key: 'light', label: t.theme.light },
  { key: 'dark', label: t.theme.dark },
  { key: 'system', label: t.theme.system },
];
---

<div class="relative text-gray-700 dark:text-white">
  <button
    id="theme-toggle-btn"
    type="button"
    class="flex size-9 appearance-none items-center justify-center rounded-full border-none transition hover:bg-gray-500/15 max-sm:size-8"
    aria-expanded="false"
    aria-controls="themes-menu"
  >
    <span class="sr-only">{t.theme.label}</span>
    <SunIcon id="light" class="theme-toggle-icon size-5 transition-all" />
    <MoonIcon
      id="dark"
      class="theme-toggle-icon absolute size-5 transition-all"
    />
    <SystemIcon
      id="system"
      class="theme-toggle-icon absolute size-5 transition-all"
    />
  </button>
  <div
    id="themes-menu"
    class="absolute top-full right-0 mt-2 hidden min-w-32 scale-80 rounded-md border border-gray-100 bg-white/90 p-1 text-lg shadow-[0_3px_10px_rgb(0,0,0,0.2)] backdrop-blur-md dark:border-gray-500/20 dark:bg-gray-900/90"
  >
    <ul>
      {
        THEMES.map(theme => (
          <li>
            <button
              type="button"
              class="themes-menu-option w-full rounded-sm px-2 py-1.5 text-left hover:bg-neutral-400/40 aria-pressed:font-semibold aria-pressed:text-yellow-700 dark:hover:bg-gray-500/50 dark:aria-pressed:text-yellow-400"
              data-theme={theme.key}
              aria-pressed="false"
            >
              {theme.label}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  #themes-menu.open {
    display: inline;
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script is:inline>
  let remove = null;
  const matchMedia = window.matchMedia('(prefers-color-scheme: dark)');
  const themesMenu = document.getElementById('themes-menu');
  const themeToggleButton = document.getElementById('theme-toggle-btn');
  const themeColorLight = document.getElementById('theme-color-light');
  const themeColorDark = document.getElementById('theme-color-dark');

  const getThemePreference = () => {
    if (typeof localStorage !== 'undefined') {
      return localStorage.getItem('theme') ?? 'system';
    }

    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light';
  };

  const updateIcon = themePreference => {
    document.querySelectorAll('.theme-toggle-icon').forEach(element => {
      element.style.scale = element.id === themePreference ? '1' : '0';
    });
  };

  const updateMenuHighlight = themePreference => {
    document.querySelectorAll('.themes-menu-option').forEach(element => {
      const isActive = element.dataset.theme === themePreference;
      element.setAttribute('aria-pressed', String(isActive));
    });
  };

  const updateTheme = () => {
    if (remove != null) {
      remove();
    }
    matchMedia.addEventListener('change', updateTheme);
    remove = () => {
      matchMedia.removeEventListener('change', updateTheme);
    };

    const themePreference = getThemePreference();
    const isDark =
      themePreference === 'dark' ||
      (themePreference === 'system' && matchMedia.matches);

    updateIcon(themePreference);
    updateMenuHighlight(themePreference);
    document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

    const themeColor = isDark ? '#030712' : '#f9fafb';
    themeColorLight.setAttribute('content', themeColor);
    themeColorDark.setAttribute('content', themeColor);
  };

  updateTheme();

  const setThemesOpen = open => {
    themesMenu.classList.toggle('open', open);
    themeToggleButton.setAttribute('aria-expanded', String(open));
  };

  // Clicking the button toggles; clicking anywhere else closes
  document.addEventListener('click', e => {
    setThemesOpen(
      themeToggleButton.contains(e.target) &&
        !themesMenu.classList.contains('open')
    );
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && themesMenu.classList.contains('open')) {
      setThemesOpen(false);
      themeToggleButton.focus({ preventScroll: true });
    }
  });

  document.querySelectorAll('.themes-menu-option').forEach(element => {
    element.addEventListener('click', () => {
      // The menu closes on this click, so hand focus back to the toggle
      themeToggleButton.focus({ preventScroll: true });
      localStorage.setItem('theme', element.dataset.theme);
      if (
        !document.startViewTransition ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        updateTheme();
        return;
      }
      document.startViewTransition(updateTheme);
    });
  });
</script>
