---
import ThemeToggle from '@/components/layout/ThemeToggle.astro';
import LanguageToggle from '@/components/layout/LanguageToggle.astro';
import MenuIcon from '@/assets/icons/Menu.astro';
import type { Translations } from '@/utils/getTranslations';
import type { Lang } from '@/i18n/config';
import { SITE } from '@/data/site';

interface Props {
  t: Translations;
  lang: Lang;
}

interface NavLink {
  label: string;
  href: string;
}

const { t, lang } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');

const navLinks: NavLink[] = [
  { label: t.header.nav.experience, href: `/${lang}#experience` },
  { label: t.header.nav.projects, href: `/${lang}/projects` },
  { label: t.header.nav.certifications, href: `/${lang}/certifications` },
  { label: t.header.nav.about, href: `/${lang}#about` },
  { label: t.header.nav.contact, href: `mailto:${SITE.email}` },
];
---

<header
  class="sticky top-0 z-40 w-full text-gray-700 backdrop-blur-xl dark:text-white"
>
  <div
    class="container mx-auto flex items-center justify-between p-4 lg:justify-evenly"
  >
    <a href={`/${lang}`} class="text-lg font-bold text-black dark:text-white">
      {t.header.name}
    </a>

    <nav class="hidden space-x-8 lg:flex" aria-label={t.header.nav_label}>
      {
        navLinks.map(link => (
          <a
            href={link.href}
            aria-current={link.href === currentPath ? 'page' : undefined}
            class="hover:text-yellow-700 dark:hover:text-yellow-400"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <button
        id="menu-toggle"
        type="button"
        class="p-1.5 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">{t.header.menu_label}</span>
        <MenuIcon />
      </button>
      <ThemeToggle t={t} />
      <LanguageToggle t={t} currentLang={lang} />
    </div>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="hidden h-screen bg-gray-50/90 backdrop-blur-lg lg:hidden dark:bg-gray-950/90"
    aria-label={t.header.nav_label}
  >
    <ul class="px-4 py-2">
      {
        navLinks.map(link => (
          <li>
            <a
              href={link.href}
              aria-current={link.href === currentPath ? 'page' : undefined}
              class="block py-2 hover:text-yellow-700 dark:hover:text-yellow-400"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Toggle mobile menu
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  const setMenuOpen = (open: boolean) => {
    mobileMenu?.classList.toggle('hidden', !open);
    menuToggle?.setAttribute('aria-expanded', String(open));
  };

  menuToggle?.addEventListener('click', () => {
    setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
  });

  // Close after picking a link (same-page anchors keep the page loaded)
  mobileMenu?.addEventListener('click', e => {
    if ((e.target as HTMLElement).closest('a')) setMenuOpen(false);
  });

  document.addEventListener('keydown', e => {
    if (
      e.key === 'Escape' &&
      menuToggle?.getAttribute('aria-expanded') === 'true'
    ) {
      setMenuOpen(false);
      menuToggle.focus();
    }
  });

  // Highlight current section
  function highlightCurrentSection() {
    const sections = ['experience', 'projects', 'certifications', 'about'];

    // Remove highlight from all nav links
    document.querySelectorAll('nav a').forEach(link => {
      link.classList.remove(
        'text-yellow-700',
        'dark:text-primary',
        'font-bold'
      );
    });

    // Highlight certifications link when on the certifications page
    const onCertifications =
      window.location.pathname.endsWith('/certifications');
    if (onCertifications) {
      document
        .querySelectorAll('nav a[href$="/certifications"]')
        .forEach(link => {
          link.classList.add(
            'text-yellow-700',
            'dark:text-primary',
            'font-bold'
          );
        });
      return;
    }

    // Highlight projects link when on the projects page
    const onProjects = window.location.pathname.endsWith('/projects');
    if (onProjects) {
      document.querySelectorAll('nav a[href$="/projects"]').forEach(link => {
        link.classList.add('text-yellow-700', 'dark:text-primary', 'font-bold');
      });
      return;
    }

    // Find which section is currently in view
    let currentSection = null;
    for (const section of sections) {
      const element = document.getElementById(section);
      if (element) {
        const rect = element.getBoundingClientRect();
        if (rect.top <= 250) {
          currentSection = section;
        }
      }
    }

    // Highlight the corresponding nav link
    if (currentSection) {
      const selector =
        currentSection === 'certifications'
          ? 'nav a[href$="/certifications"]'
          : currentSection === 'projects'
            ? 'nav a[href$="/projects"]'
            : `nav a[href$="#${currentSection}"]`;
      document.querySelectorAll(selector).forEach(link => {
        link.classList.add('text-yellow-700', 'dark:text-primary', 'font-bold');
      });
    }
  }

  // Call on load and scroll
  window.addEventListener('load', highlightCurrentSection);
  window.addEventListener('scroll', highlightCurrentSection);
</script>
