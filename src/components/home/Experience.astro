---
import { Image } from 'astro:assets';
import Calendar from '@/assets/icons/Calendar.astro';
import logoSertyf from '@/assets/images/logo-sertyf.png';
import logoUc3m from '@/assets/images/logo-uc3m.png';
import type { Translations } from '@/utils/getTranslations';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const timelineItems = [
  {
    ...t.timeline.june_2025,
    logo: logoSertyf,
    node: 'tl-node--sertyf',
    current: true,
  },
  {
    ...t.timeline.september_2022,
    logo: logoUc3m,
    node: 'tl-node--uc3m',
    current: false,
  },
  {
    ...t.timeline['2019'],
    logo: undefined,
    node: 'tl-node--icon',
    current: false,
  },
];
---

<section id="experience" class="mx-auto max-w-6xl scroll-m-20 py-16 sm:px-4">
  <div class="flex flex-row items-center gap-5 text-gray-900 dark:text-white">
    <Calendar />
    <h2
      class="font-instrument text-[40px] leading-[1.1] font-normal tracking-[-0.01em] italic"
    >
      {t.experience.title}
    </h2>
  </div>
  <ol class="tl mt-16" data-timeline>
    <span class="tl-rail" data-rail aria-hidden="true"></span>
    <span class="tl-fill" data-fill aria-hidden="true"></span>
    {
      timelineItems.map((item, index) => (
        <li
          class:list={[
            'tl-item',
            { 'tl-item--last': index === timelineItems.length - 1 },
          ]}
        >
          {item.logo ? (
            <div class:list={['tl-node', item.node]} data-node>
              <Image src={item.logo} alt={item.logo_alt} width={112} />
            </div>
          ) : (
            <div
              class:list={['tl-node', item.node]}
              data-node
              aria-hidden="true"
            >
              <svg
                width="26"
                height="26"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m4 17 6-6-6-6M12 19h8" />
              </svg>
            </div>
          )}
          <article
            class:list={['tl-card', { 'tl-card--current': item.current }]}
          >
            <div class="tl-head">
              <div>
                <h3 class="text-[22px] font-bold tracking-tight text-gray-900 dark:text-white">
                  {item.title}
                </h3>
                <p class="mt-1 text-gray-600 dark:text-gray-300">{item.org}</p>
              </div>
              <time class="tl-date" data-date>
                {item.date}
              </time>
            </div>
            <ul class="mt-4 list-disc space-y-1 pl-5 leading-relaxed text-gray-700 marker:text-yellow-500 dark:text-gray-300">
              {item.bullets.map(b => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .tl {
    position: relative;
    padding: 0;
    list-style: none;
    --tl-tile: 56px;
    --tl-line: #e5e7eb;
    --tl-surface: #fff;
    --tl-pill: #f3f4f6;
    --tl-pill-text: #374151;
  }
  :global(.dark) .tl {
    --tl-line: #374151;
    --tl-surface: #111827;
    --tl-pill: #1f2937;
    --tl-pill-text: #d1d5db;
  }
  .tl-rail,
  .tl-fill {
    position: absolute;
    left: calc(var(--tl-tile) / 2 - 1px);
    width: 2px;
  }
  .tl-rail {
    background: var(--tl-line);
  }
  .tl-fill {
    background: var(--color-primary);
    transition: height 0.12s linear;
  }
  .tl-item {
    position: relative;
    display: grid;
    grid-template-columns: var(--tl-tile) minmax(0, 1fr);
    column-gap: 32px;
    align-items: start;
    padding-bottom: 40px;
  }
  .tl-item--last {
    padding-bottom: 0;
  }
  .tl-node {
    position: relative;
    z-index: 1;
    display: flex;
    width: var(--tl-tile);
    height: var(--tl-tile);
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid #d1d5db;
    background: #fff;
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .tl-node :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .tl-node--sertyf {
    padding: 5px;
  }
  .tl-node--uc3m :global(img) {
    transform: scale(1.12);
  }
  .tl-node--icon {
    background: var(--tl-pill);
    color: var(--tl-pill-text);
    border-color: var(--tl-line);
  }
  .tl-node.is-active {
    border: 2px solid var(--color-primary);
    box-shadow: 0 0 0 6px
      color-mix(in oklab, var(--color-primary) 18%, transparent);
  }
  .tl-card {
    border: 1px solid var(--tl-line);
    border-radius: 0.75rem;
    background: var(--tl-surface);
    padding: 24px 28px;
    transition:
      box-shadow 0.3s,
      border-color 0.3s;
  }
  .tl-card--current {
    border-color: var(--color-primary);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
  }
  .tl-item:hover .tl-card {
    border-color: var(--color-primary);
    box-shadow:
      0 10px 15px -3px rgba(0, 0, 0, 0.1),
      0 4px 6px -4px rgba(0, 0, 0, 0.1);
  }
  .tl-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .tl-date {
    flex: none;
    padding: 6px 14px;
    border-radius: 9999px;
    background: var(--tl-pill);
    color: var(--tl-pill-text);
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .tl-date.is-active {
    background: var(--color-primary);
    color: #111827;
  }
  @media (max-width: 640px) {
    .tl {
      --tl-tile: 44px;
    }
    .tl-item {
      column-gap: 16px;
    }
    .tl-card {
      padding: 18px 20px;
    }
  }
</style>

<script>
  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  const rail = tl?.querySelector<HTMLElement>('[data-rail]');
  const fill = tl?.querySelector<HTMLElement>('[data-fill]');

  if (tl && rail && fill) {
    const nodes = Array.from(tl.querySelectorAll<HTMLElement>('[data-node]'));
    const dates = Array.from(tl.querySelectorAll<HTMLElement>('[data-date]'));

    const update = () => {
      const top = tl.getBoundingClientRect().top;
      const nodeY = (n: HTMLElement) =>
        (() => {
          const r = n.getBoundingClientRect();
          return r.top - top + r.height / 2;
        })();
      const railStart = nodeY(nodes[0]);
      const railEnd = nodeY(nodes[nodes.length - 1]);
      rail.style.top = fill.style.top = `${railStart}px`;
      rail.style.height = `${railEnd - railStart}px`;

      // Fill progress is measured ~55% down the viewport
      const reached = Math.min(window.innerHeight * 0.55 - top, railEnd);
      fill.style.height = `${Math.max(0, reached - railStart)}px`;
      nodes.forEach((n, i) => {
        const active = nodeY(n) <= reached;
        n.classList.toggle('is-active', active);
        dates[i].classList.toggle('is-active', active);
      });
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>
