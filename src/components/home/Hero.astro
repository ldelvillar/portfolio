---
import { Image } from 'astro:assets';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Github from '@/assets/icons/logos/Github.astro';
import Linkedin from '@/assets/icons/logos/Linkedin.astro';
import Envelope from '@/assets/icons/Envelope.astro';
import type { Translations } from '@/utils/getTranslations';
import { SITE } from '@/data/site';
import profile from '@/assets/images/profile.webp';

interface Props {
  t: Translations;
}

interface SocialData {
  name: string;
  url: string;
  icon: AstroComponentFactory;
}

const { t } = Astro.props;

const socials: SocialData[] = [
  {
    name: 'GitHub',
    url: SITE.github,
    icon: Github,
  },
  {
    name: 'LinkedIn',
    url: SITE.linkedin,
    icon: Linkedin,
  },
  {
    name: SITE.email,
    url: `mailto:${SITE.email}`,
    icon: Envelope,
  },
];
---

<section id="hero" class="mx-auto max-w-5xl py-4 sm:px-4 md:py-16">
  <div class="flex flex-col-reverse items-center gap-6 md:flex-row">
    <div class="md:basis-2/3">
      <div
        class="hero-anim bounce-in-down flex flex-row-reverse gap-6 md:flex-col"
      >
        <div>
          <h1
            class="text-4xl font-bold text-gray-800 md:text-5xl dark:text-white"
          >
            Hey, <span class="text-yellow-500 dark:text-yellow-400"
              >{t.hero.title}</span
            >
          </h1>
          <span
            class="animate-background-shine mt-1 inline-flex bg-[linear-gradient(110deg,#8a8833,45%,#0f172a,55%,#8a8833)] bg-size-[250%_100%] bg-clip-text text-xl font-semibold text-transparent dark:bg-[linear-gradient(110deg,#f4ffb6,45%,#607406,55%,#f4ffb6)]"
          >
            {t.hero.subtitle}
          </span>
        </div>
        <div
          class="hero-anim back-in-down flex items-center md:mt-8 md:hidden md:basis-1/3"
        >
          <Image
            src={profile}
            alt={SITE.name}
            width={240}
            height={240}
            widths={[240, 480]}
            sizes="160px"
            loading="eager"
            class="w-40 rotate-3 rounded-full outline outline-offset-2 outline-gray-500"
          />
        </div>
      </div>
      <div class="hero-anim back-in-left">
        <p class="mt-4 text-xl font-semibold text-gray-600 dark:text-gray-300">
          {t.hero.description1}
          <span class="text-yellow-500 dark:text-yellow-400">
            {` ${t.hero.description2} `}
          </span>{t.hero.description3}
        </p>
      </div>
      <nav class="hero-anim back-in-up mt-8 flex flex-wrap gap-5 text-lg">
        {
          socials.map(social => (
            <a
              href={social.url}
              target="_blank"
              class="flex flex-row items-center justify-center gap-2 rounded-full border border-gray-600 bg-linear-to-r from-gray-400 to-gray-600 px-3 py-1 font-medium text-white transition-transform hover:scale-105 dark:from-slate-800 dark:to-slate-950"
            >
              <social.icon class="size-6" />
              <span>{social.name}</span>
            </a>
          ))
        }
      </nav>
    </div>

    <div
      class="hero-anim back-in-down hidden items-center md:mt-8 md:flex md:basis-1/3"
    >
      <Image
        src={profile}
        alt={SITE.name}
        width={240}
        height={240}
        widths={[240, 720, 960]}
        sizes="(min-width: 1440px) 960px, (min-width: 1024px) 720px, 240px"
        loading="eager"
        class="w-60 rotate-3 rounded-full outline-1 outline-offset-2 outline-gray-500"
      />
    </div>
  </div>
</section>

<style>
  /* Entrance animations adapted from animate.css 4.1.1 (MIT, © 2020 Daniel Eden) */
  .hero-anim {
    animation-duration: 2s;
    animation-fill-mode: both;
  }

  .bounce-in-down {
    animation-name: bounceInDown;
  }

  .back-in-down {
    animation-name: backInDown;
  }

  .back-in-left {
    animation-name: backInLeft;
  }

  .back-in-up {
    animation-name: backInUp;
  }

  @media print, (prefers-reduced-motion: reduce) {
    .hero-anim {
      animation: none;
    }
  }

  @keyframes bounceInDown {
    from,
    60%,
    75%,
    90%,
    to {
      animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    0% {
      opacity: 0;
      transform: translate3d(0, -3000px, 0) scaleY(3);
    }

    60% {
      opacity: 1;
      transform: translate3d(0, 25px, 0) scaleY(0.9);
    }

    75% {
      transform: translate3d(0, -10px, 0) scaleY(0.95);
    }

    90% {
      transform: translate3d(0, 5px, 0) scaleY(0.985);
    }

    to {
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes backInDown {
    0% {
      transform: translateY(-1200px) scale(0.7);
      opacity: 0.7;
    }

    80% {
      transform: translateY(0px) scale(0.7);
      opacity: 0.7;
    }

    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes backInLeft {
    0% {
      transform: translateX(-2000px) scale(0.7);
      opacity: 0.7;
    }

    80% {
      transform: translateX(0px) scale(0.7);
      opacity: 0.7;
    }

    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes backInUp {
    0% {
      transform: translateY(1200px) scale(0.7);
      opacity: 0.7;
    }

    80% {
      transform: translateY(0px) scale(0.7);
      opacity: 0.7;
    }

    100% {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>
