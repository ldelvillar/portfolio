---
import { Image } from 'astro:assets';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Github from '@/assets/icons/logos/Github.astro';
import Linkedin from '@/assets/icons/logos/Linkedin.astro';
import Envelope from '@/assets/icons/Envelope.astro';
import RightArrow from '@/assets/icons/RightArrow.astro';
import type { Lang } from '@/i18n/config';
import type { Translations } from '@/utils/getTranslations';
import { SITE } from '@/data/site';
import profile from '@/assets/images/profile.webp';

interface Props {
  t: Translations;
  lang: Lang;
}

interface SocialData {
  name: string;
  url: string;
  icon: AstroComponentFactory;
}

const { t, lang } = Astro.props;

const [firstName, ...restName] = SITE.name.split(' ');

const socials: SocialData[] = [
  {
    name: 'GitHub',
    url: SITE.github,
    icon: Github,
  },
  {
    name: 'LinkedIn',
    url: SITE.linkedin,
    icon: Linkedin,
  },
  {
    name: 'Email',
    url: `mailto:${SITE.email}`,
    icon: Envelope,
  },
];
---

<section id="hero" class="mx-auto max-w-5xl pt-8 pb-4 sm:px-4 md:py-20">
  <div
    class="flex flex-col-reverse gap-8 md:flex-row md:items-center md:justify-between md:gap-12"
  >
    <div class="flex min-w-0 flex-col gap-7">
      <h1
        class="font-instrument text-[72px] leading-[0.88] font-normal tracking-[-0.02em] text-gray-900 sm:text-[96px] md:text-[112px] lg:text-[136px] dark:text-white"
      >
        {firstName}<br /><span class="italic">{restName.join(' ')}</span>
      </h1>
      <p
        class="max-w-xl text-lg leading-relaxed font-medium text-gray-600 md:text-xl dark:text-gray-300"
      >
        {t.hero.description1}
        <span class="font-semibold text-yellow-700 dark:text-yellow-400">
          {` ${t.hero.description2} `}
        </span>{t.hero.description3}
      </p>
      <nav
        class="grid grid-cols-3 gap-3 sm:flex sm:flex-wrap sm:items-center"
        aria-label={t.hero.contact_label}
      >
        <a
          href={`/${lang}/projects`}
          class="col-span-3 inline-flex min-h-12 items-center justify-center rounded-full bg-gray-900 px-6 font-semibold text-white transition hover:bg-gray-700 sm:col-auto dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200"
        >
          {t.hero.cta}
          <RightArrow class="h-3 w-3" />
        </a>
        {
          socials.map(social => (
            <a
              href={social.url}
              target="_blank"
              aria-label={social.name}
              class="inline-flex h-12 items-center justify-center rounded-full border border-gray-300 bg-white text-gray-900 transition hover:border-yellow-500 hover:text-yellow-700 sm:w-12 dark:border-gray-700 dark:bg-gray-900 dark:text-white dark:hover:border-yellow-400 dark:hover:text-yellow-400"
            >
              <social.icon />
            </a>
          ))
        }
      </nav>
    </div>
    <Image
      src={profile}
      alt={SITE.name}
      width={280}
      height={280}
      widths={[280, 560]}
      sizes="(min-width: 1024px) 280px, (min-width: 768px) 224px, (min-width: 640px) 160px, 128px"
      loading="eager"
      class="w-32 shrink-0 rounded-full object-cover outline-1 outline-offset-[6px] outline-gray-400 sm:w-40 md:w-56 lg:w-[280px] dark:outline-gray-600"
    />
  </div>
</section>
