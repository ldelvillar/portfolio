---
import UserIcon from '@/assets/icons/UserOutline.astro';
import type { Translations } from '@/utils/getTranslations';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section id="about" class="mx-auto max-w-6xl scroll-m-20 py-16 sm:px-4">
  <h2
    class="font-instrument mb-6 flex items-center text-[40px] leading-[1.1] font-normal tracking-[-0.01em] text-gray-900 italic dark:text-white"
  >
    <span class="mr-5">
      <UserIcon class="size-8" />
    </span>
    {t.about.title}
  </h2>
  <div
    class="mt-2 overflow-hidden rounded-xl border border-gray-200 bg-[radial-gradient(120%_80%_at_50%_-10%,color-mix(in_oklab,var(--color-primary)_9%,transparent)_0%,transparent_60%),linear-gradient(180deg,#ffffff_0%,#f9fafb_100%)] dark:border-gray-800 dark:bg-[radial-gradient(120%_80%_at_50%_-10%,color-mix(in_oklab,var(--color-primary)_9%,transparent)_0%,transparent_60%),linear-gradient(180deg,#0c0c10_0%,#08080b_100%)]"
  >
    <div
      class="flex items-center gap-3 border-b border-gray-200 px-5 py-3 dark:border-gray-800"
    >
      <span class="bg-primary h-2 w-2 rounded-sm"></span>
      <span class="font-mono text-xs text-gray-500 dark:text-gray-400"
        >{t.about.terminalPath}</span
      >
    </div>
    <div class="flex flex-col gap-5 px-6 py-8 md:px-8">
      <p class="font-medium text-gray-700 dark:text-gray-300">
        <span aria-hidden="true" class="text-accent mr-2 font-mono">$</span>
        {t.about.introduction.part1}
        <span class="text-accent">{` ${t.about.introduction.highlight} `}</span>
        {t.about.introduction.part2}
      </p>
      <p class="font-medium text-gray-700 dark:text-gray-300">
        <span aria-hidden="true" class="text-accent mr-2 font-mono">$</span>
        {` ${t.about.skills.part1} `}
        <span class="text-accent">{` ${t.about.skills.highlight1}`}</span>
        {t.about.skills.part2}
      </p>
      <p class="font-medium text-gray-700 dark:text-gray-300">
        <span aria-hidden="true" class="text-accent mr-2 font-mono">$</span>
        {`${t.about.goal.part1} `}
        <span class="text-accent">{t.about.goal.highlight}</span>
        {t.about.goal.part2}
      </p>
    </div>
  </div>
</section>
