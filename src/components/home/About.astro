---
import UserIcon from '@/assets/icons/User.astro';
import type { Translations } from '@/utils/getTranslations';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section id="about" class="mx-auto max-w-5xl scroll-m-20 py-16 sm:px-4">
  <h2
    class="mb-6 flex items-center text-3xl font-bold text-gray-900 dark:text-white"
  >
    <span class="mr-5">
      <UserIcon />
    </span>
    {t.about.title}
  </h2>
  <div
    class="mt-2 overflow-hidden rounded-xl border border-gray-200 bg-[radial-gradient(120%_80%_at_50%_-10%,rgba(250,204,21,0.09)_0%,transparent_60%),linear-gradient(180deg,#ffffff_0%,#f9fafb_100%)] dark:border-gray-800 dark:bg-[radial-gradient(120%_80%_at_50%_-10%,rgba(250,204,21,0.09)_0%,transparent_60%),linear-gradient(180deg,#0c0c10_0%,#08080b_100%)]"
  >
    <div
      class="flex items-center gap-3 border-b border-gray-200 px-5 py-3 dark:border-gray-800"
    >
      <span class="h-2 w-2 rounded-sm bg-yellow-500 dark:bg-yellow-400"></span>
      <span class="font-mono text-xs text-gray-500 dark:text-gray-400"
        >{t.about.terminalPath}</span
      >
    </div>
    <div class="flex flex-col gap-5 px-6 py-8 md:px-8">
      <p class="font-medium text-gray-700 dark:text-gray-300">
        <span class="mr-2 font-mono text-yellow-500 dark:text-yellow-400"
          >$</span
        >
        {t.about.introduction.part1}
        <span class="text-yellow-500 dark:text-yellow-400"
          >{` ${t.about.introduction.highlight} `}</span
        >
        {t.about.introduction.part2}
      </p>
      <p class="font-medium text-gray-700 dark:text-gray-300">
        <span class="mr-2 font-mono text-yellow-500 dark:text-yellow-400"
          >$</span
        >
        {` ${t.about.skills.part1} `}
        <span class="text-yellow-500 dark:text-yellow-400"
          >{` ${t.about.skills.highlight1} `}</span
        >
        {` ${t.about.skills.part2} `}
        <span class="text-yellow-500 dark:text-yellow-400"
          >{` ${t.about.skills.highlight2} `}</span
        >
        {t.about.skills.part3}
      </p>
      <p class="font-medium text-gray-700 dark:text-gray-300">
        <span class="mr-2 font-mono text-yellow-500 dark:text-yellow-400"
          >$</span
        >
        {t.about.goal}
      </p>
    </div>
  </div>
</section>
