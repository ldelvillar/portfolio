---

<section id="techstack" class="mx-auto max-w-6xl scroll-m-20 py-16 sm:px-4">
  <h2
    class="font-instrument mb-6 flex items-center text-[40px] leading-[1.1] font-normal tracking-[-0.01em] text-gray-900 italic dark:text-white"
  >
    <span class="mr-5">
      <Stack class="size-8" />
    </span>
    {t.techstack.title}
  </h2>

  <div class="flex flex-col gap-5 md:grid md:grid-cols-2">
    {
      FIELDS.map(field => (
        <div class="atropos my-atropos">
          <div class="atropos-scale">
            <div class="atropos-rotate">
              <div class="atropos-inner">
                <div class="flex h-full flex-col items-center rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-transparent">
                  <h3 class="mt-3 bg-linear-to-t from-[#a16207] to-[#854d0e] bg-clip-text text-3xl font-bold text-transparent dark:from-[#fffec9] dark:to-[#efeb00]">
                    {field.name}
                  </h3>
                  <ul class="my-6 grid grid-cols-3 gap-6">
                    {field.technologies.map(technology => (
                      <li class="flex flex-col items-center justify-center text-gray-800 dark:text-gray-200">
                        <div class="text-black dark:text-white">
                          <technology.icon class="size-13" />
                        </div>
                        <span>{technology.name}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  // Load the tilt effect only when the section gets close to the viewport
  // (and skip it entirely for users who prefer reduced motion)
  const section = document.getElementById('techstack');
  if (
    section &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const observer = new IntersectionObserver(
      async ([entry]) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        const { default: Atropos } = await import('atropos');
        document.querySelectorAll('.my-atropos').forEach(el => {
          Atropos({ el: el as HTMLElement, rotateTouch: false });
        });
      },
      { rootMargin: '600px' }
    );
    observer.observe(section);
  }
</script>
