---
import List from '@/assets/icons/List.astro';
import AstroIcon from '@/assets/icons/logos/AstroIcon.astro';
import ReactIcon from '@/assets/icons/logos/ReactIcon.astro';
import Vue from '@/assets/icons/logos/Vue.astro';
import NextJS from '@/assets/icons/logos/NextJS.astro';
import Tailwind from '@/assets/icons/logos/Tailwind.astro';
import SWR from '@/assets/icons/logos/SWR.astro';
import TypeScript from '@/assets/icons/logos/Typescript.astro';
import Python from '@/assets/icons/logos/Python.astro';
import Express from '@/assets/icons/logos/Express.astro';
import FastAPI from '@/assets/icons/logos/Fastapi.astro';
import C from '@/assets/icons/logos/C.astro';
import PostgreSQL from '@/assets/icons/logos/PostgreSQL.astro';
import SQLServer from '@/assets/icons/logos/SQLServer.astro';
import MongoDB from '@/assets/icons/logos/MongoDB.astro';
import GCP from '@/assets/icons/logos/GCP.astro';
import Azure from '@/assets/icons/logos/Azure.astro';
import Docker from '@/assets/icons/logos/Docker.astro';
import Kubernetes from '@/assets/icons/logos/Kubernetes.astro';
import GithubActions from '@/assets/icons/logos/GithubActions.astro';
import Linux from '@/assets/icons/logos/Linux.astro';
import Redis from '@/assets/icons/logos/Redis.astro';
import Langgraph from '@/assets/icons/logos/Langgraph.astro';
import LangChain from '@/assets/icons/logos/LangChain.astro';
import CrewAi from '@/assets/icons/logos/CrewAi.astro';
import Ollama from '@/assets/icons/logos/Ollama.astro';
import Vllm from '@/assets/icons/logos/Vllm.astro';
import LlamaIndex from '@/assets/icons/logos/Llamaindex.astro';
import MCP from '@/assets/icons/logos/MCP.astro';
import HuggingFace from '@/assets/icons/logos/HuggingFace.astro';
import type { Translations } from '@/utils/getTranslations';

// @ts-ignore
import 'atropos/css';

interface Props {
  t: Translations;
}

interface TechField {
  name: string;
  technologies: {
    icon: typeof AstroIcon;
    name: string;
  }[];
}

const { t } = Astro.props;

const FIELDS: TechField[] = [
  {
    name: 'Backend',
    technologies: [
      {
        icon: Python,
        name: 'Python',
      },
      {
        icon: TypeScript,
        name: 'TypeScript',
      },

      {
        icon: FastAPI,
        name: 'FastAPI',
      },
      {
        icon: Express,
        name: 'Express',
      },
      {
        icon: C,
        name: 'C',
      },
      {
        icon: PostgreSQL,
        name: 'PostgreSQL',
      },
      {
        icon: SQLServer,
        name: 'SQL Server',
      },
      {
        icon: MongoDB,
        name: 'MongoDB',
      },
    ],
  },
  {
    name: t.techstack.ai,
    technologies: [
      {
        icon: Langgraph,
        name: 'LangGraph',
      },
      {
        icon: LangChain,
        name: 'LangChain',
      },
      {
        icon: CrewAi,
        name: 'CrewAI',
      },
      {
        icon: Ollama,
        name: 'Ollama',
      },
      {
        icon: Vllm,
        name: 'vLLM',
      },
      {
        icon: LlamaIndex,
        name: 'LlamaIndex',
      },
      {
        icon: MCP,
        name: 'MCP',
      },
      {
        icon: HuggingFace,
        name: 'Hugging Face',
      },
    ],
  },
  {
    name: t.techstack.cloud,
    technologies: [
      {
        icon: GCP,
        name: 'GCP',
      },
      {
        icon: Azure,
        name: 'Azure',
      },
      {
        icon: Docker,
        name: 'Docker',
      },
      {
        icon: Kubernetes,
        name: 'Kubernetes',
      },
      {
        icon: Redis,
        name: 'Redis',
      },
      {
        icon: GithubActions,
        name: 'GitHub Actions',
      },
      {
        icon: Linux,
        name: 'Linux',
      },
    ],
  },
  {
    name: 'Frontend',
    technologies: [
      {
        icon: AstroIcon,
        name: 'Astro',
      },
      {
        icon: ReactIcon,
        name: 'React',
      },
      {
        icon: NextJS,
        name: 'Next.js',
      },
      {
        icon: Vue,
        name: 'Vue.js',
      },
      {
        icon: Tailwind,
        name: 'Tailwind CSS',
      },
      {
        icon: SWR,
        name: 'SWR',
      },
    ],
  },
];
---

<section id="techstack" class="mx-auto max-w-5xl scroll-m-20 py-16 sm:px-4">
  <h2
    class="mb-6 flex items-center text-3xl font-bold text-gray-900 dark:text-white"
  >
    <span class="mr-5">
      <List />
    </span>
    {t.techstack.title}
  </h2>

  <div class="flex flex-col gap-5 md:grid md:grid-cols-2">
    {
      FIELDS.map(field => (
        <div class="atropos my-atropos">
          <div class="atropos-scale">
            <div class="atropos-rotate">
              <div class="atropos-inner">
                <div class="flex h-full flex-col items-center rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-transparent">
                  <h2 class="mt-3 bg-linear-to-t from-[#fffc5f] to-[#c9b500] bg-clip-text text-3xl font-bold text-transparent dark:from-[#fffec9] dark:to-[#efeb00]">
                    {field.name}
                  </h2>
                  <div class="my-6 grid grid-cols-3 gap-6">
                    {field.technologies.map(technology => (
                      <div class="flex flex-col items-center justify-center text-gray-800 dark:text-gray-200">
                        <div class="text-black dark:text-white">
                          <technology.icon class="size-13" />
                        </div>
                        <h3>{technology.name}</h3>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  import Atropos from 'atropos';

  // Initialize
  document.querySelectorAll('.my-atropos').forEach(el => {
    Atropos({ el: el as HTMLElement });
  });
</script>
