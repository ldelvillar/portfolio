---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import { getTranslations } from '@/utils/getTranslations';
import { CERTS } from '@/data/certifications';
import { langStaticPaths, type Lang } from '@/i18n/config';
import { fmtDate } from '@/utils/fmtDate';

export async function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = getTranslations(lang);

const totalHours = new Intl.NumberFormat(lang).format(
  CERTS.reduce((s, c) => s + c.hours, 0)
);
const [latest, ...others] = [...CERTS].sort((a, b) =>
  b.date.localeCompare(a.date)
);
---

<Layout title={t.certifications.title} lang={lang} page="certifications">
  <main id="main" class="mx-auto w-full max-w-7xl flex-1 px-4 py-16 sm:px-6">
    <header
      class="mb-10 flex flex-wrap items-end justify-between gap-x-6 gap-y-2"
    >
      <h1
        class="font-instrument text-4xl font-normal tracking-tight text-gray-900 italic sm:text-5xl dark:text-white"
      >
        {t.certifications.title}
      </h1>
      <p class="text-base text-gray-600 dark:text-gray-400">
        {t.certifications.total_hours.replace('{hours}', totalHours)}
      </p>
    </header>

    <!-- Latest certification -->
    <section
      class="grid gap-8 rounded-2xl border border-gray-200 bg-white bg-[radial-gradient(90%_120%_at_0%_0%,rgba(34,211,238,0.10)_0%,transparent_55%)] p-5 sm:p-7 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center dark:border-gray-800 dark:bg-[#0b0f19]"
    >
      <div
        class="rounded-xl bg-gray-100 p-3 shadow-[0_30px_60px_-20px_rgba(0,0,0,0.35)] sm:p-3.5 dark:bg-gray-800 dark:shadow-[0_30px_60px_-20px_rgba(0,0,0,0.6)]"
      >
        {
          latest.image && (
            <Image
              src={latest.image}
              alt={latest.title}
              widths={[480, 720, 1000]}
              sizes="(min-width: 1024px) 640px, 100vw"
              loading="eager"
              class="block aspect-1000/773 w-full rounded bg-white object-cover"
            />
          )
        }
      </div>
      <div class="flex flex-col gap-5">
        <span
          class="inline-flex items-center gap-2 font-mono text-[11px] tracking-widest text-yellow-700 uppercase dark:text-yellow-400"
        >
          <span class="inline-block h-px w-4 bg-yellow-500 dark:bg-yellow-400"
          ></span>
          {t.certifications.latest_earned}
        </span>
        <h2
          class="text-2xl leading-tight font-bold text-gray-900 sm:text-[28px] dark:text-white"
        >
          {latest.title}
        </h2>
        <p class="text-[15px] leading-relaxed text-gray-600 dark:text-gray-400">
          {t.certifications.items[latest.id].desc}
        </p>
        <div class="grid grid-cols-3 gap-2">
          <div
            class="rounded-lg border border-gray-200 px-3 py-2.5 dark:border-gray-800"
          >
            <div
              class="font-mono text-[10px] tracking-widest text-gray-500 uppercase dark:text-gray-400"
            >
              {t.certifications.issuer}
            </div>
            <div class="mt-1 text-sm text-gray-900 dark:text-white">
              {latest.issuer}
            </div>
          </div>
          <div
            class="rounded-lg border border-gray-200 px-3 py-2.5 dark:border-gray-800"
          >
            <div
              class="font-mono text-[10px] tracking-widest text-gray-500 uppercase dark:text-gray-400"
            >
              {t.certifications.date}
            </div>
            <div class="mt-1 text-sm text-gray-900 dark:text-white">
              {fmtDate(latest.date, t)}
            </div>
          </div>
          <div
            class="rounded-lg border border-gray-200 px-3 py-2.5 dark:border-gray-800"
          >
            <div
              class="font-mono text-[10px] tracking-widest text-gray-500 uppercase dark:text-gray-400"
            >
              {t.certifications.hours_label}
            </div>
            <div class="mt-1 text-sm text-gray-900 dark:text-white">
              {latest.hours} h
            </div>
          </div>
        </div>
        <div class="flex flex-wrap gap-2.5 pt-1">
          <a
            href={latest.credentialUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 rounded-full bg-yellow-400 px-[18px] text-sm font-semibold text-gray-900 transition-colors hover:bg-yellow-300"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-3.5 w-3.5"
              aria-hidden="true"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
            {t.certifications.view_credential}
          </a>
          {
            latest.pdfUrl && (
              <a
                href={latest.pdfUrl}
                download={`${latest.id}.pdf`}
                class="inline-flex min-h-11 items-center gap-2 rounded-full border border-gray-300 px-[18px] text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3.5 w-3.5"
                  aria-hidden="true"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                {t.certifications.download_pdf}
              </a>
            )
          }
        </div>
      </div>
    </section>

    <!-- More credentials -->
    <div class="mt-14 mb-5 flex items-center gap-4">
      <h2
        class="font-instrument text-2xl font-normal tracking-tight text-gray-900 italic dark:text-white"
      >
        {t.certifications.more}
      </h2>
      <span class="h-px flex-1 bg-gray-200 dark:bg-gray-800"></span>
      <span class="font-mono text-xs text-gray-500 dark:text-gray-400">
        {String(others.length).padStart(2, '0')}
      </span>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      {
        others.map(cert => (
          <article class="grid grid-cols-1 items-center gap-[18px] rounded-2xl border border-gray-200 bg-white p-3.5 transition-colors hover:border-gray-300 sm:grid-cols-[200px_minmax(0,1fr)] dark:border-gray-800 dark:bg-gray-900 dark:hover:border-gray-700">
            <div class="relative aspect-1000/773 overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-transparent">
              {cert.image ? (
                <Image
                  src={cert.image}
                  alt={cert.title}
                  widths={[200, 400, 800]}
                  sizes="(min-width: 640px) 200px, 100vw"
                  class="absolute inset-0 h-full w-full object-cover object-top"
                />
              ) : (
                <div
                  class="absolute inset-0 grid place-items-center bg-[#0c0c10] font-mono text-3xl"
                  style={`color: ${cert.tint}; background-image: radial-gradient(120% 80% at 50% 0%, ${cert.tint}38 0%, transparent 60%); text-shadow: 0 0 30px ${cert.tint}73;`}
                >
                  {cert.mono}
                </div>
              )}
            </div>
            <div class="flex min-w-0 flex-col gap-2 pr-1">
              <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-gray-500 dark:text-gray-400">
                <span>{cert.issuer}</span>
                <span class="h-1 w-1 rounded-full bg-gray-400 dark:bg-gray-500" />
                <span>{fmtDate(cert.date, t)}</span>
                {cert.status === 'in-progress' && (
                  <span class="rounded-full border border-amber-500/40 px-2 py-px text-[10px] tracking-widest text-amber-700 uppercase dark:text-amber-300">
                    {t.certifications.status_in_progress}
                  </span>
                )}
              </div>
              <h3 class="text-base leading-snug font-semibold text-gray-900 dark:text-white">
                {cert.title}
              </h3>
              <p class="text-[13px] leading-relaxed text-gray-600 dark:text-gray-400">
                {t.certifications.items[cert.id].desc}
              </p>
              <div class="flex flex-wrap gap-5">
                {cert.status === 'in-progress' ? (
                  <span
                    title={t.certifications.credential_pending}
                    class="inline-flex min-h-8 cursor-not-allowed items-center gap-1.5 text-[13px] font-semibold text-gray-500 dark:text-gray-400"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-3.5 w-3.5"
                      aria-hidden="true"
                    >
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      <path d="m9 12 2 2 4-4" />
                    </svg>
                    {t.certifications.view_credential}
                    <span class="sr-only">
                      : {t.certifications.credential_pending}
                    </span>
                  </span>
                ) : (
                  <a
                    href={cert.credentialUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-8 items-center gap-1.5 text-[13px] font-semibold text-gray-900 transition-colors hover:text-yellow-700 dark:text-white dark:hover:text-yellow-400"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-3.5 w-3.5"
                      aria-hidden="true"
                    >
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      <path d="m9 12 2 2 4-4" />
                    </svg>
                    {t.certifications.view_credential}
                  </a>
                )}
                {cert.pdfUrl && (
                  <a
                    href={cert.pdfUrl}
                    download={`${cert.id}.pdf`}
                    class="inline-flex min-h-8 items-center gap-1.5 text-[13px] font-medium text-gray-600 transition-colors hover:text-yellow-700 dark:text-gray-300 dark:hover:text-yellow-400"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-3.5 w-3.5"
                      aria-hidden="true"
                    >
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                      <polyline points="7 10 12 15 17 10" />
                      <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                    {t.certifications.download_pdf}
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </main>
</Layout>
