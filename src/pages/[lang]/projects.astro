---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import { getTranslations } from '@/utils/getTranslations';
import {
  PROJECTS,
  TECH_META,
  FALLBACK_BG,
  type ProjectStatus,
} from '@/data/projects';
import { langStaticPaths, type Lang } from '@/i18n/config';

export async function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = getTranslations(lang);

const tp = t.projects_page;

const total = PROJECTS.length;
const liveCount = PROJECTS.filter(p => p.status === 'prod').length;
const latest = [...PROJECTS].sort((a, b) => b.year.localeCompare(a.year))[0];
const mainStack = 'TypeScript';

const featured = PROJECTS.find(p => p.featured);
const rest = PROJECTS.filter(p => !p.featured);

function statusLabel(s: string): string {
  if (s === 'prod') return tp.status_prod;
  if (s === 'dev') return tp.status_dev;
  return tp.status_archived;
}

function statusBadgeClasses(s: string): string {
  if (s === 'prod') return 'border-green-500/25 bg-green-500/10 text-green-300';
  if (s === 'dev') return 'border-amber-500/25 bg-amber-500/10 text-amber-300';
  return 'border-gray-500/25 bg-gray-500/10 text-gray-300';
}

function isPreviewDisabled(s: ProjectStatus): boolean {
  return s === 'archived';
}
---

<Layout title={`${tp.title} - ldelvillar`} lang={lang}>
  <main class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <!-- Section header -->
    <header class="mb-8 flex flex-wrap items-center gap-4">
      <h1
        class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
      >
        {tp.title}
      </h1>
      <span
        class="ml-auto hidden font-mono text-sm text-gray-500 sm:block dark:text-gray-400"
        >{tp.subtitle}</span
      >
    </header>

    <!-- Summary strip -->
    <div
      class="mb-8 grid grid-cols-2 divide-x divide-y overflow-hidden rounded-xl border border-gray-200 sm:grid-cols-4 sm:divide-y-0 dark:divide-gray-800 dark:border-gray-800"
    >
      <div class="flex flex-col gap-1 bg-white px-5 py-4 dark:bg-gray-900">
        <span
          class="text-xs tracking-widest text-gray-500 uppercase dark:text-gray-400"
          >{tp.summary.total}</span
        >
        <span
          class="font-blimone text-2xl font-semibold text-gray-900 dark:text-white"
          >{String(total).padStart(2, '0')}</span
        >
      </div>
      <div class="flex flex-col gap-1 bg-white px-5 py-4 dark:bg-gray-900">
        <span
          class="text-xs tracking-widest text-gray-500 uppercase dark:text-gray-400"
          >{tp.summary.live}</span
        >
        <span
          class="font-blimone flex items-center gap-2 text-2xl font-semibold text-gray-900 dark:text-white"
        >
          <span class="inline-block h-2 w-2 rounded-full bg-yellow-400"></span>
          {liveCount}<span
            class="text-sm font-normal text-gray-500 dark:text-gray-400"
            >/ {total}</span
          >
        </span>
      </div>
      <div class="flex flex-col gap-1 bg-white px-5 py-4 dark:bg-gray-900">
        <span
          class="text-xs tracking-widest text-gray-500 uppercase dark:text-gray-400"
          >{tp.summary.stack}</span
        >
        <span
          class="font-blimone text-2xl font-semibold text-gray-900 dark:text-white"
          >{mainStack}</span
        >
      </div>
      <div class="flex flex-col gap-1 bg-white px-5 py-4 dark:bg-gray-900">
        <span
          class="text-xs tracking-widest text-gray-500 uppercase dark:text-gray-400"
          >{tp.summary.latest}</span
        >
        <span class="text-lg font-semibold text-gray-900 dark:text-white">
          {tp.items[latest.id].short}<span
            class="ml-2 text-sm font-normal text-gray-500 dark:text-gray-400"
            >{latest.year}</span
          >
        </span>
      </div>
    </div>

    <!-- Search -->
    <div
      class="mb-8 flex items-center gap-2 rounded-full border border-gray-200 px-4 py-2 text-gray-400 transition-colors focus-within:border-gray-400 sm:w-auto sm:min-w-[320px] dark:border-gray-700 dark:focus-within:border-gray-500"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-3.5 w-3.5 shrink-0"
      >
        <circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        id="proj-search"
        type="search"
        placeholder={tp.search_placeholder}
        class="min-w-0 flex-1 border-0 bg-transparent text-sm text-gray-900 outline-none placeholder:text-gray-400 dark:text-white"
      />
    </div>

    {
      featured && (
        <section
          class="proj-featured mb-12 grid grid-cols-1 overflow-hidden rounded-xl border border-gray-200 bg-white lg:grid-cols-[1.15fr_1fr] dark:border-gray-800 dark:bg-gray-900"
          style={`--proj-tint: ${featured.tint}`}
          data-title={tp.items[featured.id].title.toLowerCase()}
          data-stack={featured.stack.join(',').toLowerCase()}
          data-desc={tp.items[featured.id].desc.toLowerCase()}
        >
          <div class="relative min-h-[260px] overflow-hidden border-b border-gray-200 lg:border-r lg:border-b-0 dark:border-gray-800">
            {featured.image && (
              <Image
                src={featured.image}
                alt={tp.items[featured.id].title}
                width={900}
                height={600}
                densities={[1, 2]}
                class="absolute inset-0 h-full w-full object-cover object-top"
                loading="eager"
              />
            )}
          </div>

          <div class="flex flex-col gap-4 p-6 sm:p-8">
            <div class="flex items-center justify-between gap-3">
              <span class="inline-flex items-center gap-2 font-mono text-[11px] tracking-widest text-yellow-500 uppercase dark:text-yellow-400">
                <span class="inline-block h-px w-4 bg-yellow-500 dark:bg-yellow-400" />
                {tp.featured}
              </span>
              <span
                class={`inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 font-mono text-[9px] tracking-widest uppercase ${statusBadgeClasses(featured.status)}`}
              >
                <span
                  class={`h-1.5 w-1.5 rounded-full ${featured.status === 'prod' ? 'animate-pulse bg-green-400' : featured.status === 'dev' ? 'bg-amber-400' : 'bg-gray-400'}`}
                />
                {statusLabel(featured.status)}
              </span>
            </div>

            <h2 class="text-2xl leading-tight font-semibold tracking-tight text-gray-900 sm:text-3xl dark:text-white">
              {tp.items[featured.id].title}
            </h2>

            <p class="max-w-prose text-sm leading-relaxed text-gray-600 dark:text-gray-300">
              {tp.items[featured.id].desc}
            </p>

            <ul class="flex flex-wrap gap-2">
              {featured.stack.map(s => {
                const meta = TECH_META[s];
                const Icon = meta?.icon;
                return (
                  <li class="shrink-0">
                    <span
                      class={`flex items-center gap-x-2 rounded-full ${meta?.bgcolor ?? FALLBACK_BG} px-2 py-1 text-sm whitespace-nowrap text-gray-200`}
                    >
                      {Icon && <Icon class="size-4" />}
                      {s}
                    </span>
                  </li>
                );
              })}
            </ul>

            <div class="grid grid-cols-3 divide-x divide-gray-200 overflow-hidden rounded-lg border border-gray-200 dark:divide-gray-800 dark:border-gray-800">
              {featured.stats.map(s => (
                <div class="flex flex-col gap-0.5 bg-white p-3 dark:bg-gray-900">
                  <span class="text-[10px] tracking-widest text-gray-500 uppercase dark:text-gray-400">
                    {s.k}
                  </span>
                  <span
                    class={`font-mono text-sm ${s.accent ? 'text-yellow-500 dark:text-yellow-400' : 'text-gray-900 dark:text-white'}`}
                  >
                    {s.v}
                  </span>
                </div>
              ))}
            </div>

            <div class="mt-1 flex flex-wrap gap-2">
              <button
                class="inline-flex items-center gap-2 rounded-full bg-yellow-400 px-4 py-2 text-sm font-medium text-gray-900 transition-colors hover:bg-yellow-300"
                data-dialog={`project-${featured.id}`}
              >
                {tp.actions.more}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3.5 w-3.5"
                >
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </button>
              {featured.preview && (
                <a
                  href={
                    isPreviewDisabled(featured.status)
                      ? undefined
                      : featured.preview
                  }
                  target={
                    isPreviewDisabled(featured.status) ? undefined : '_blank'
                  }
                  rel={
                    isPreviewDisabled(featured.status)
                      ? undefined
                      : 'noopener noreferrer'
                  }
                  aria-disabled={
                    isPreviewDisabled(featured.status) ? 'true' : undefined
                  }
                  tabindex={isPreviewDisabled(featured.status) ? -1 : undefined}
                  class={`inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors ${
                    isPreviewDisabled(featured.status)
                      ? 'pointer-events-none cursor-not-allowed border-gray-200 text-gray-400 dark:border-gray-800 dark:text-gray-600'
                      : 'border-gray-200 text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800'
                  }`}
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-3.5 w-3.5"
                  >
                    <path d="M15 3h6v6" />
                    <path d="M10 14 21 3" />
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  </svg>
                  {tp.actions.live}
                </a>
              )}
              <a
                href={featured.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3.5 w-3.5"
                >
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                </svg>
                {tp.actions.repo}
              </a>
            </div>
          </div>
        </section>
      )
    }

    <!-- Cards grid -->
    <div id="cards-grid" class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      {
        rest.map(project => (
          <article
            class="proj-card relative flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition-all hover:border-gray-300 dark:border-gray-800 dark:bg-gray-900 dark:hover:border-gray-700"
            data-title={tp.items[project.id].title.toLowerCase()}
            data-stack={project.stack.join(',').toLowerCase()}
            data-desc={tp.items[project.id].desc.toLowerCase()}
            style={project.status === 'archived' ? 'opacity: 0.78' : ''}
          >
            <div class="relative aspect-video overflow-hidden border-b border-gray-200 bg-gray-100 dark:border-gray-800 dark:bg-gray-950">
              {project.image && (
                <Image
                  src={project.image}
                  alt={tp.items[project.id].title}
                  width={800}
                  height={450}
                  densities={[1, 2]}
                  class="absolute inset-0 h-full w-full object-cover object-top"
                  loading="lazy"
                />
              )}
              <span
                class={`absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 font-mono text-[9px] tracking-widest uppercase backdrop-blur-sm ${statusBadgeClasses(project.status)}`}
              >
                <span
                  class={`h-1.5 w-1.5 rounded-full ${project.status === 'prod' ? 'animate-pulse bg-green-400' : project.status === 'dev' ? 'bg-amber-400' : 'bg-gray-400'}`}
                />
                {statusLabel(project.status)}
              </span>
            </div>

            <div class="flex flex-1 flex-col gap-3 p-5">
              <h3 class="text-lg leading-snug font-semibold text-gray-900 dark:text-white">
                {tp.items[project.id].title}
              </h3>
              <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {tp.items[project.id].desc}
              </p>
              <ul class="flex flex-wrap gap-2">
                {project.stack.slice(0, 4).map(s => {
                  const meta = TECH_META[s];
                  const Icon = meta?.icon;
                  return (
                    <li class="shrink-0">
                      <span
                        class={`flex items-center gap-x-2 rounded-full ${meta?.bgcolor ?? FALLBACK_BG} px-2 py-1 text-sm whitespace-nowrap text-gray-200`}
                      >
                        {Icon && <Icon class="size-4" />}
                        {s}
                      </span>
                    </li>
                  );
                })}
                {project.stack.length > 4 && (
                  <li class="shrink-0">
                    <span class="inline-flex items-center rounded-full border border-gray-200 bg-gray-50 px-2 py-1 text-sm font-medium text-gray-500 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">
                      +{project.stack.length - 4}
                    </span>
                  </li>
                )}
              </ul>
            </div>

            <div class="flex items-center justify-between border-t border-dashed border-gray-200 px-5 py-3 font-mono text-[11px] text-gray-500 dark:border-gray-800 dark:text-gray-400">
              <button
                type="button"
                class="group inline-flex items-center gap-1.5 font-mono text-[11px] tracking-wider text-gray-600 uppercase transition-colors hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
                data-dialog={`project-${project.id}`}
              >
                {tp.actions.more}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3 w-3 transition-transform group-hover:translate-x-0.5"
                >
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </button>
              <div class="flex gap-1.5">
                {project.preview && (
                  <a
                    href={
                      isPreviewDisabled(project.status)
                        ? undefined
                        : project.preview
                    }
                    target={
                      isPreviewDisabled(project.status) ? undefined : '_blank'
                    }
                    rel={
                      isPreviewDisabled(project.status)
                        ? undefined
                        : 'noopener noreferrer'
                    }
                    aria-disabled={
                      isPreviewDisabled(project.status) ? 'true' : undefined
                    }
                    tabindex={
                      isPreviewDisabled(project.status) ? -1 : undefined
                    }
                    aria-label="Live"
                    class={`grid h-7 w-7 place-items-center rounded-md border transition-colors ${
                      isPreviewDisabled(project.status)
                        ? 'pointer-events-none cursor-not-allowed border-gray-200 text-gray-300 dark:border-gray-800 dark:text-gray-600'
                        : 'border-gray-200 text-gray-600 hover:bg-gray-50 hover:text-gray-900 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white'
                    }`}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-3 w-3"
                    >
                      <path d="M15 3h6v6" />
                      <path d="M10 14 21 3" />
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    </svg>
                  </a>
                )}
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Repo"
                  class="grid h-7 w-7 place-items-center rounded-md border border-gray-200 text-gray-600 transition-colors hover:bg-gray-50 hover:text-gray-900 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-3 w-3"
                  >
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }

      <div
        id="empty-state"
        class="col-span-full hidden rounded-xl border border-dashed border-gray-200 py-16 text-center dark:border-gray-800"
      >
        <p class="text-base text-gray-500 dark:text-gray-400">
          {tp.no_results}
        </p>
        <p class="mt-2 font-mono text-xs text-gray-400 dark:text-gray-500">
          {tp.no_results_hint}
        </p>
      </div>
    </div>

    <!-- Project modals -->
    {
      PROJECTS.map(p => (
        <dialog
          id={`project-${p.id}`}
          aria-labelledby={`project-${p.id}-title`}
          class="m-auto max-h-[calc(100vh-3rem)] w-[calc(100%-3rem)] max-w-2xl flex-col overflow-hidden rounded-2xl border border-gray-700 bg-gray-900 shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm open:flex"
        >
          <div class="flex items-center justify-between border-b border-gray-800 px-4 py-3">
            <div class="flex gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-red-500/80" />
              <span class="h-2.5 w-2.5 rounded-full bg-yellow-400/80" />
              <span class="h-2.5 w-2.5 rounded-full bg-green-500/80" />
            </div>
            <div class="truncate rounded-full border border-gray-700 bg-gray-800 px-3 py-1 font-mono text-xs text-gray-400">
              <>
                <span>https://</span>
                <b class="font-medium text-gray-200">{p.url}</b>
              </>
            </div>
            <form method="dialog">
              <button
                class="grid h-7 w-7 place-items-center rounded-md text-gray-400 transition-colors hover:bg-gray-800 hover:text-white"
                aria-label="Close"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3.5 w-3.5"
                >
                  <line x1="18" y1="6" x2="6" y2="18" />
                  <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
              </button>
            </form>
          </div>
          <div class="overflow-y-auto">
            <div
              class="relative grid aspect-16/8 place-items-center overflow-hidden border-b border-gray-800"
              style={`background: radial-gradient(120% 80% at 50% 0%, ${p.tint}2e 0%, transparent 65%), linear-gradient(180deg, #0c0c10 0%, #08080b 100%)`}
            >
              <div
                class="pointer-events-none absolute inset-0 opacity-40"
                style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,.05) 1px, transparent 0); background-size: 14px 14px; mask-image: radial-gradient(80% 100% at 50% 0%, #000 30%, transparent 80%);"
              />
              <span
                class={`relative font-mono leading-none font-medium ${p.mono.length > 6 ? 'text-3xl sm:text-4xl' : p.mono.length > 4 ? 'text-4xl sm:text-5xl' : 'text-5xl sm:text-6xl'}`}
                style={`color: ${p.tint}; text-shadow: 0 0 60px ${p.tint}66;`}
              >
                {p.mono}
              </span>
            </div>
            <div class="flex flex-col gap-4 p-6 sm:p-8">
              <div class="flex flex-wrap items-center gap-2 font-mono text-xs tracking-wider text-gray-400 uppercase">
                <span>{p.year}</span>
                <span class="h-[3px] w-[3px] rounded-full bg-gray-500" />
                <span>{tp.items[p.id].duration}</span>
                <span class="h-[3px] w-[3px] rounded-full bg-gray-500" />
                <span
                  class={`inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[9px] tracking-widest ${statusBadgeClasses(p.status)}`}
                >
                  {statusLabel(p.status)}
                </span>
              </div>
              <h3
                id={`project-${p.id}-title`}
                class="text-xl leading-snug font-semibold text-white sm:text-2xl"
              >
                {tp.items[p.id].title}
              </h3>
              <p class="text-sm leading-relaxed text-gray-300">
                {tp.items[p.id].desc}
              </p>

              <div class="grid grid-cols-3 divide-x divide-gray-800 overflow-hidden rounded-lg border border-gray-800">
                {p.stats.map(s => (
                  <div class="flex flex-col gap-0.5 bg-gray-900 p-3">
                    <span class="text-[10px] tracking-widest text-gray-500 uppercase">
                      {s.k}
                    </span>
                    <span
                      class={`font-mono text-sm ${s.accent ? 'text-yellow-400' : 'text-white'}`}
                    >
                      {s.v}
                    </span>
                  </div>
                ))}
              </div>

              <div class="flex flex-wrap gap-1.5">
                {p.stack.map(s => {
                  const meta = TECH_META[s];
                  const Icon = meta?.icon;
                  return (
                    <span
                      class={`flex items-center gap-x-2 rounded-full ${meta?.bgcolor ?? FALLBACK_BG} px-2 py-1 text-sm whitespace-nowrap text-gray-200`}
                    >
                      {Icon && <Icon class="size-4" />}
                      {s}
                    </span>
                  );
                })}
              </div>

              <div class="flex flex-col gap-2 rounded-lg border border-gray-800 bg-gray-950 p-4">
                {tp.items[p.id].highlights.map(h => (
                  <div class="flex gap-2 text-sm leading-relaxed text-gray-300">
                    <span
                      class="font-mono font-semibold"
                      style={`color: ${p.tint}`}
                    >
                      ›
                    </span>
                    <span>{h}</span>
                  </div>
                ))}
              </div>

              <div class="flex flex-wrap gap-2">
                {p.preview && (
                  <a
                    href={isPreviewDisabled(p.status) ? undefined : p.preview}
                    target={isPreviewDisabled(p.status) ? undefined : '_blank'}
                    rel={
                      isPreviewDisabled(p.status)
                        ? undefined
                        : 'noopener noreferrer'
                    }
                    aria-disabled={
                      isPreviewDisabled(p.status) ? 'true' : undefined
                    }
                    tabindex={isPreviewDisabled(p.status) ? -1 : undefined}
                    class={`inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition-colors ${
                      isPreviewDisabled(p.status)
                        ? 'pointer-events-none cursor-not-allowed bg-gray-800 text-gray-500'
                        : 'bg-yellow-400 text-gray-900 hover:bg-yellow-300'
                    }`}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-3.5 w-3.5"
                    >
                      <path d="M15 3h6v6" />
                      <path d="M10 14 21 3" />
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    </svg>
                    <span>{tp.actions.live}</span>
                  </a>
                )}
                <a
                  href={p.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full border border-gray-700 px-4 py-2 text-sm font-medium text-gray-200 transition-colors hover:bg-gray-800"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-3.5 w-3.5"
                  >
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                  <span>{tp.actions.repo}</span>
                </a>
              </div>
            </div>
          </div>
        </dialog>
      ))
    }
  </main>

  <script>
    // --- Search ---
    const cards = document.querySelectorAll<HTMLElement>('.proj-card');
    const featuredEl = document.querySelector<HTMLElement>('.proj-featured');
    const searchInput = document.getElementById(
      'proj-search'
    ) as HTMLInputElement | null;
    const emptyState = document.getElementById('empty-state');
    const visibleCount = document.getElementById('visible-count');

    let searchQuery = '';

    function matches(el: HTMLElement) {
      const q = searchQuery.trim().toLowerCase();
      return (
        !q ||
        (el.dataset.title ?? '').includes(q) ||
        (el.dataset.stack ?? '').includes(q) ||
        (el.dataset.desc ?? '').includes(q)
      );
    }

    function filterCards() {
      let visible = 0;
      cards.forEach(card => {
        if (matches(card)) {
          card.classList.remove('hidden');
          visible++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (featuredEl) {
        featuredEl.classList.toggle('hidden', !matches(featuredEl));
      }

      emptyState?.classList.toggle('hidden', visible > 0);
      if (visibleCount) visibleCount.textContent = String(visible);
    }

    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value;
      filterCards();
    });

    // --- Modals ---
    document.querySelectorAll<HTMLElement>('[data-dialog]').forEach(btn => {
      const dialog = document.getElementById(
        btn.dataset.dialog ?? ''
      ) as HTMLDialogElement | null;
      btn.addEventListener('click', () => dialog?.showModal());
    });

    // Clicks on ::backdrop are dispatched to the <dialog> itself
    document.querySelectorAll('dialog').forEach(dialog => {
      dialog.addEventListener('click', e => {
        if (e.target === dialog) dialog.close();
      });
    });
  </script>
</Layout>
